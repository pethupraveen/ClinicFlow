# Public origin used for canonical URLs, Open Graph and the sitemap.
# Optional: on Vercel it defaults to the production domain, locally to
# http://localhost:3000. Uncomment only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Added by the Neon Vercel Marketplace integration. Keep this server-only
# value out of source control; it is required for Phase 3 analytics writes.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
