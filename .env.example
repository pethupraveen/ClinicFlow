# Public origin used for canonical URLs, Open Graph and the sitemap.
# Optional: on Vercel it defaults to the production domain, locally to
# http://localhost:3000. Uncomment only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Added by the Supabase Vercel Marketplace integration. Keep these server-only
# values out of source control; they are required for Phase 3 analytics writes.
# POSTGRES_URL is the pooled connection used by the app; migrations use
# POSTGRES_URL_NON_POOLING. Any other Postgres works via DATABASE_URL.
# POSTGRES_URL=postgres://user:password@host:6543/postgres?sslmode=require
# POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/postgres?sslmode=require

# Phase 4 auth: Google sign-in through Supabase (the integration adds these;
# the STORAGE_ prefix is fine). The Google client ID/secret live in Supabase.
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_ANON_KEY=...
# AUTH_RATE_LIMIT_SALT=long-random-string   # optional
